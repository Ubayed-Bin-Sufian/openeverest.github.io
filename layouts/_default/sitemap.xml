{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- /* Same as Hugo's built-in sitemap, minus auto-generated taxonomy archives (/tags/). */}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $pages := where .Pages "Sitemap.Disable" "ne" true }}
  {{- $pages = where $pages "Kind" "not in" (slice "taxonomy" "term") }}
  {{- range $pages }}
    {{- if .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}
  </url>
    {{- end }}
  {{- end }}
  {{- /* MkDocs docs are static assets, so merge in their own sitemaps (URLs rewritten by
         hack/fix_docs_seo.py). Indexed: current/ plus the newest release if it is a preview. */}}
  {{- $docVersions := slice "current" }}
  {{- with site.GetPage "/docs" }}{{ with index (.Params.versions | default slice) 0 }}{{ if .prerelease }}
    {{- $docVersions = $docVersions | append .release }}
  {{- end }}{{ end }}{{ end }}
  {{- range $docVersions }}
    {{- with resources.Get (printf "documentation/%s/sitemap.xml" .) }}
      {{- $urls := (. | transform.Unmarshal).url }}
      {{- if reflect.IsMap $urls }}{{ $urls = slice $urls }}{{ end }}
      {{- range $urls }}
  <url>
    <loc>{{ .loc }}</loc>{{ with .lastmod }}
    <lastmod>{{ . }}</lastmod>{{ end }}
  </url>
      {{- end }}
    {{- end }}
  {{- end }}
</urlset>
